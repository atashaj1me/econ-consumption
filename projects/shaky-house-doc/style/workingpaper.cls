\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{workingpaper}[2026/04/22 v0.3 Working-Paper shared base class]

% =====================================================================
%  WORKING-PAPER BASE CLASS
%  File: <project>/style/workingpaper.cls
% ---------------------------------------------------------------------
%  Internal base class shared by ochna.cls (personal research brand)
%  and fulbright.cls (Fulbright University Vietnam).
%
%  Do NOT \documentclass{workingpaper} directly in a paper -- load a
%  brand class instead. This file exists solely to factor out the ~85%
%  of content that was duplicated across the two brand classes.
%
%  Project layout this class is designed for (generated by `newtex`):
%
%     <project>/main.tex            the paper
%     <project>/references.bib      per-paper bibliography
%     <project>/style/              this file + one brand class + logo
%                                   + math-macros.tex (vendored copies)
%     <project>/graphs/             paper-local figures
%
%  Paths are given in-argument (\documentclass{style/fulbright},
%  \LoadClass{style/workingpaper}), relative to main.tex, so a bare
%  `pdflatex main.tex` resolves everything with no TEXINPUTS. Every
%  project is self-contained; refresh vendored copies with
%  `newtex update`.
%
%  Brand classes populate the masthead via the commands declared under
%  "Masthead machinery" below: \classification, \subject, \logofile,
%  \logoscale, \mastheadbottomskip.
%
%  Typefaces: Latin Modern Roman (body and headings), loaded via lmodern
%  with T1 encoding.
% =====================================================================


% ---------------------------------------------------------------------
%  Class options
%
%  Recognized:
%    anonymous    strip author line (double-blind submission mode)
%    draft        passed through to article; hyperref turns links grey
%    final        passed through to article (default)
%    <other>      passed to article (a4paper, letterpaper, 10pt, ...)
% ---------------------------------------------------------------------
\newif\ifwp@anonymous   \wp@anonymousfalse

\DeclareOption{anonymous}{\wp@anonymoustrue}
\DeclareOption*{\PassOptionsToClass{\CurrentOption}{article}}
\ExecuteOptions{a4paper,11pt}
\ProcessOptions\relax

\LoadClass{article}


% ---------------------------------------------------------------------
%  Core packages
% ---------------------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage[dvipsnames]{xcolor}   % load early so later packages see colors

% Fonts and math.
%   Latin Modern (Roman / Sans / Typewriter) as the default typeface.
%   fontenc T1  -- 8-bit encoding: accented glyphs, copy-safe PDF text
%   lmodern     -- sets \rmdefault=lmr, \sfdefault=lmss, \ttdefault=lmtt
%   anyfontsize -- allows arbitrary \fontsize values without warnings
%   amsmath + amsthm + amssymb for math and theorem styles
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{anyfontsize}
\RequirePackage{amsmath}
\RequirePackage{amsthm}               % proper theorem styles + built-in `proof`
\RequirePackage{amssymb}
\RequirePackage{bm}

% Layout
\RequirePackage{fancyhdr}
\RequirePackage{geometry}
  \geometry{margin=0.8in}
\RequirePackage{parskip}
  \setlength{\parskip}{10pt}
  \setlength{\parindent}{20pt}
\RequirePackage{titlesec}

% Floats, lists, tables
\RequirePackage{pgfplots}
\RequirePackage{float}
\RequirePackage{enumitem}
\RequirePackage{dirtytalk}
\RequirePackage{booktabs}
\RequirePackage{tabularx}

% References
\RequirePackage{apacite}
\RequirePackage[toc,page]{appendix}

% ---------------------------------------------------------------------
%  Compatibility patch: apacite (2013, unmaintained) vs. hyperref
%  (2024+).
%
%  Symptom without this patch: the THIRD pdflatex pass -- once .aux
%  contains resolved \bibcite entries -- aborts with
%    "! Undefined control sequence. \hyper@@link -> ...".
%
%  Root cause: hyperref, at package-load time, checks
%  \@ifundefined{NAT@parse}. If undefined (i.e. natbib is not loaded),
%  hyperref installs its OWN \bibcite that emits \hyper@@link calls.
%  apacite tries to "fool" hyperref by defining \NAT@parse, but does
%  so in \AtBeginDocument -- which fires AFTER hyperref has already
%  taken over \bibcite. The hyperref-installed \bibcite builds a
%  \b@<key> macro whose body is \hyper@@link[...]{}{...}{...}; when
%  apacite later does \protected@edef on \csname b@<key>\endcsname,
%  the non-robust \hyper@@link expansion hits \Hy@reserved@a and
%  friends in an unexpandable context, and TeX gives up.
%
%  Fix: pre-define \NAT@parse BEFORE loading hyperref so the
%  bibcite-takeover branch is skipped entirely. apacite's own
%  \bibcite = \APACbibcite then remains in force, citations resolve
%  normally, and cite->bib anchors are wired up via apacite's
%  \hyper@natlinkstart / \hyper@natanchorstart hooks (which hyperref
%  supplies unconditionally).
%
%  Inside a .cls file, @-as-letter is already active, so no
%  \makeatletter / \makeatother wrapper is needed.
% ---------------------------------------------------------------------
\@ifundefined{NAT@parse}{%
  \def\NAT@parse{This is a fake natbib command to fool hyperref.}%
}{}

% hyperref must load after almost everything
\RequirePackage[colorlinks=true, allcolors=BlueViolet]{hyperref}


% ---------------------------------------------------------------------
%  Graphics search path
%
%  Resolves \includegraphics{foo.png} against, in order:
%    ./            per-paper working dir (main.tex)
%    ./graphs/     per-paper figures
%    ./figures/    per-paper figures (alternative name)
%    ./style/      vendored brand logos
% ---------------------------------------------------------------------
\graphicspath{%
  {./}%
  {./graphs/}%
  {./figures/}%
  {./style/}%
}


% ---------------------------------------------------------------------
%  Section heading sizes -- brand classes can override via
%  \renewcommand of the three \wp@*size macros below. The values are
%  looked up lazily at typeset time, so a brand class only needs to
%  renew the macros (no re-\titleformat required).
% ---------------------------------------------------------------------
\providecommand{\wp@sectionsize}     {\fontsize{13pt}{16pt}}
\providecommand{\wp@subsectionsize}  {\fontsize{12pt}{15pt}}
\providecommand{\wp@subsubsectionsize}{\fontsize{12pt}{14pt}}

\titleformat{\section}
  {\normalfont\wp@sectionsize\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}
  {\normalfont\wp@subsectionsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}
  {\normalfont\wp@subsubsectionsize\bfseries}{\thesubsubsection}{1em}{}


% ---------------------------------------------------------------------
%  Math operators
%
%  Kept in-class for backward compatibility. If the list grows, migrate
%  to style/math-operators.tex and \input from main.tex.
% ---------------------------------------------------------------------
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\plim}{plim}


% ---------------------------------------------------------------------
%  Theorem environments (AMS-styled, section-scoped numbering)
%
%  Three style families:
%    plain       -- theorem, proposition, lemma, corollary  (italic body)
%    definition  -- definition, model, example              (roman body)
%    remark      -- remark, assumption                      (roman body, italic head)
%
%  The `proof` environment comes from amsthm; do NOT \newtheorem it.
% ---------------------------------------------------------------------
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{proposition}{Proposition}[section]
\newtheorem{lemma}{Lemma}[section]
\newtheorem{corollary}{Corollary}[section]

\theoremstyle{definition}
\newtheorem{definition}{Definition}[section]
\newtheorem{model}{Model}[section]
\newtheorem{example}{Example}[section]
\newtheorem{problem}{Problem}[section]

\theoremstyle{remark}
\newtheorem{remark}{Remark}[section]
\newtheorem{assumption}{Assumption}[section]

\newenvironment{solution}
  {\begin{proof}[Solution]}
  {\end{proof}}

% ---------------------------------------------------------------------
%  Abstract -- compact, left-flush, inline "Abstract" label
% ---------------------------------------------------------------------
\renewenvironment{abstract}
  {\noindent\fontsize{10pt}{12pt}\selectfont\textbf{Abstract\quad}\ignorespaces}
  {\par}


% ---------------------------------------------------------------------
%  Bibliography defaults
% ---------------------------------------------------------------------
\renewcommand{\refname}{References}
\bibliographystyle{apacite}


% ---------------------------------------------------------------------
%  Masthead machinery
%
%  Brand classes populate these via the public commands below.
%  Defaults are empty/placeholder; \maketitle skips empty slots.
% ---------------------------------------------------------------------
% Reference empty macro for the \ifx emptiness checks in \maketitle.
% (\newcommand produces \long macros, so comparing against \@empty --
% which is non-long -- never matches; compare against this instead.)
\newcommand{\wp@mastheadempty}{}
\newcommand{\wp@classification}{}
\newcommand{\wp@subject}{}
\newcommand{\wp@logofile}{}
\newcommand{\wp@logoscale}{1}
\newcommand{\wp@mastheadbottomskip}{-5pt}

\newcommand{\classification}[1]{\renewcommand{\wp@classification}{#1}}
\newcommand{\subject}[1]{\renewcommand{\wp@subject}{#1}}
\newcommand{\logofile}[1]{\renewcommand{\wp@logofile}{#1}}
\newcommand{\logoscale}[1]{\renewcommand{\wp@logoscale}{#1}}
\newcommand{\mastheadbottomskip}[1]{\renewcommand{\wp@mastheadbottomskip}{#1}}


% ---------------------------------------------------------------------
%  \maketitle
%
%  Two-column masthead:
%    left    brand logo (if \logofile was set)
%    right   classification / subject / date (each line suppressed if empty)
%  followed by title, author (or "withheld" in anonymous mode), and space.
% ---------------------------------------------------------------------
\renewcommand{\maketitle}{%
  \begin{flushleft}%
    \begin{minipage}{0.5\textwidth}%
      \ifx\wp@logofile\wp@mastheadempty\else
        \includegraphics[scale=\wp@logoscale]{\wp@logofile}%
      \fi
    \end{minipage}%
    \begin{minipage}{0.5\textwidth}%
      \raggedleft\scriptsize
      \ifx\wp@classification\wp@mastheadempty\else
        \vspace{-1pt}\wp@classification\\%
      \fi
      \ifx\wp@subject\wp@mastheadempty\else
        \vspace{-1pt}\wp@subject\\%
      \fi
      \vspace{-1pt}\@date
    \end{minipage}%
    \vspace{\wp@mastheadbottomskip}
    \vspace{5pt}

    {\Large\@title\par}%
    \vspace{10pt}%
    \ifwp@anonymous
      {\normalsize\textit{Author(s) withheld for blind review}\par}%
    \else
      {\normalsize\@author\par}%
    \fi
    \vspace{5pt}%
  \end{flushleft}%
  \vspace{5pt}%
}


% ---------------------------------------------------------------------
%  Document-start hooks
%    - fix 11pt body with 14pt leading (brand classes may override)
%    - wire \@title / \@author into PDF metadata
% ---------------------------------------------------------------------
\AtBeginDocument{%
  \fontsize{11pt}{14pt}\selectfont
  \hypersetup{%
    pdftitle={\@title},%
    pdfauthor={\ifwp@anonymous Anonymous\else\@author\fi}%
  }%
}


\endinput