# Build commands (generated by newtex). All real work is done by latexmk,
# configured in .latexmkrc: incremental, bibtex only when needed, aux
# files under build/.
#
#   make            build main.pdf (only the passes that are needed)
#   make watch      rebuild automatically on every save
#   make quick      one LaTeX pass, no bibtex (fast draft)
#   make clean      remove build/ clutter, keep main.pdf
#   make distclean  remove build/ and the PDF(s)
#
# Which .tex files get built is set by @default_files in .latexmkrc.

.PHONY: all watch quick clean distclean

all:
	latexmk

watch:
	latexmk -pvc -view=none

quick:
	latexmk -g -e '$$max_repeat=1' -e '$$bibtex_use=0'

clean:
	latexmk -c
	rm -rf build

distclean:
	latexmk -C
	rm -rf build
